# Conexión agrupada (pooler) de Supabase, usada por la aplicación (puerto 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?pgbouncer=true"

# Conexión directa a PostgreSQL, usada por las migraciones de Prisma (puerto 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres"

# Credenciales públicas del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
